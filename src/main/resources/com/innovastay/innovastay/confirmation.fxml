<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!-- CHANGE CONTROLLER TO ConfirmationController -->
<VBox prefHeight="720.0" prefWidth="1280.0" stylesheets="@app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.innovastay.innovastay.ConfirmationController">

    <children>

        <!-- ✅ Top Logo Bar -->
        <HBox alignment="CENTER_LEFT" prefHeight="64.0" spacing="10" styleClass="upper-form">
            <children>
                <!-- Left: Logo -->
                <ImageView fitHeight="54.0" onMouseClicked="#goHome" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                    <image>
                        <Image url="@image/inova%20logo(1)(1).png" />
                    </image>
                    <HBox.margin>
                        <Insets left="15.0" />
                    </HBox.margin>
                </ImageView>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Right: Menu Icon -->
                <ImageView fitHeight="45.0" fitWidth="45.0" opacity="0.76" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@image/icon-menu.png" />
                    </image>
                    <HBox.margin>
                        <Insets right="15.0" />
                    </HBox.margin>
                </ImageView>
            </children>
        </HBox>

        <!-- ✅ Confirmation Section -->
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #f8f9fa; -fx-padding: 40;">

            <!-- Success Icon -->
            <VBox alignment="CENTER" spacing="15.0">
                <Label style="-fx-text-fill: #2c5aa0; -fx-font-size: 32; -fx-font-weight: bold;" text="Booking Confirmed!" />
                <Label style="-fx-text-fill: #666; -fx-font-size: 18;" text="Your reservation has been successfully made" />
                <VBox.margin>
                    <Insets top="5.0" />
                </VBox.margin>
            </VBox>

            <!-- Confirmation Card -->
            <VBox maxWidth="800.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 5);">

                <!-- Confirmation Header -->
                <VBox alignment="CENTER_LEFT" prefHeight="31.0" prefWidth="800.0" spacing="10.0" style="-fx-padding: 25; -fx-background-color: #2c5aa0;">
                    <Label style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" text="Booking Details" />
                </VBox>

                <!-- Confirmation Body -->
                <VBox spacing="25.0" style="-fx-padding: 30;">

                    <!-- Booking Information -->
                    <GridPane hgap="20.0" vgap="15.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        </rowConstraints>
                        <children>
                            <!-- ADD fx:id TO ALL LABELS -->
                            <Label fx:id="confirmationNumberLabel" style="-fx-font-weight: bold; -fx-text-fill: #2c5aa0;" text="Confirmation Number:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <Label fx:id="confirmationNumberValue" style="-fx-font-weight: bold; -fx-text-fill: #333;" text="INNOVA20241115001" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2c5aa0;" text="Hotel:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <Label fx:id="hotelNameLabel" style="-fx-text-fill: #333;" text="Limketkai Luxe Hotel" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2c5aa0;" text="Check-in Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <Label fx:id="checkInDateLabel" style="-fx-text-fill: #333;" text="November 15, 2024" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2c5aa0;" text="Check-out Date:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <Label fx:id="checkOutDateLabel" style="-fx-text-fill: #333;" text="November 17, 2024" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2c5aa0;" text="Room Type:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                            <Label fx:id="roomTypeLabel" style="-fx-text-fill: #333;" text="Deluxe King Room" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2c5aa0;" text="Guests:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                            <Label fx:id="guestsLabel" style="-fx-text-fill: #333;" text="2 Adults" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2c5aa0;" text="Total Amount:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                            <Label fx:id="totalAmountLabel" style="-fx-font-weight: bold; -fx-text-fill: #2c5aa0; -fx-font-size: 16;" text="PHP 4,161.00" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2c5aa0;" text="Status:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                            <Label fx:id="statusLabel" style="-fx-font-weight: bold; -fx-text-fill: green; -fx-font-size: 14;" text="CONFIRMED" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                        </children>
                    </GridPane>

                    <Separator />

                    <!-- Guest Information -->
                    <VBox spacing="10.0">
                        <Label style="-fx-text-fill: #2c5aa0; -fx-font-size: 18; -fx-font-weight: bold;" text="Guest Information" />
                        <GridPane hgap="15.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Primary Guest:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <Label fx:id="guestNameLabel" text="John Doe" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label style="-fx-font-weight: bold;" text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <Label fx:id="guestEmailLabel" text="johndoe@email.com" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label style="-fx-font-weight: bold;" text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <Label fx:id="guestPhoneLabel" text="+63 912 345 6789" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            </children>
                        </GridPane>
                    </VBox>

                    <Separator />

                    <!-- Action Buttons - ADD onAction METHODS -->
                    <HBox alignment="CENTER" spacing="20.0">
                        <Button onAction="#viewMyBookings" style="-fx-background-color: #2c5aa0; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 8; -fx-font-size: 14;" text="VIEW MY BOOKINGS" />
                        <Button onAction="#printConfirmation" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 8; -fx-font-size: 14;" text="PRINT CONFIRMATION" />
                        <Button onAction="#backToHome" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 8; -fx-font-size: 14;" text="BACK TO HOME" />
                    </HBox>

                </VBox>
            </VBox>
            <VBox.margin>
                <Insets />
            </VBox.margin>
        </VBox>
    </children>
</VBox>