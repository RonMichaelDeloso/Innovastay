<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #1B3C53;" styleClass="bg" stylesheets="@app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.innovastay.innovastay.LoginController">
   <children>
      <BorderPane prefHeight="797.0" prefWidth="1280.0">
         <center>
            <VBox fx:id="Frame" alignment="CENTER" prefHeight="720.0" prefWidth="1024.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox fx:id="Frame" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="580.0" prefWidth="482.0" style="-fx-background-color: white;" styleClass="form" stylesheets="@app.css">
                     <children>
                        <ImageView fitHeight="143.0" fitWidth="266.0" pickOnBounds="true" preserveRatio="true">
                           <cursor>
                              <Cursor fx:constant="DEFAULT" />
                           </cursor>
                           <VBox.margin>
                              <Insets right="25.0" top="10.0" />
                           </VBox.margin>
                           <image>
                              <Image url="@image/inova%20logo.png" />
                           </image>
                        </ImageView>
                        <VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="316.0" prefWidth="376.0">
                           <children>
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Change Password">
                                 <font>
                                    <Font size="27.0" />
                                 </font>
                                 <VBox.margin>
                                    <Insets top="-14.0" />
                                 </VBox.margin>
                              </Text>

                              <!-- Message Label for displaying errors/success -->
                              <Label fx:id="changePasswordMessageLabel" prefHeight="20.0" prefWidth="376.0" textAlignment="CENTER" textFill="RED">
                                 <VBox.margin>
                                    <Insets top="10.0" />
                                 </VBox.margin>
                              </Label>

                              <VBox alignment="TOP_RIGHT" prefHeight="292.0" prefWidth="376.0">
                                 <children>
                                    <!-- Email Field -->
                                    <TextField fx:id="changePasswordEmailField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="55.0" prefWidth="376.0" promptText="Enter Email" styleClass="input-field">
                                       <VBox.margin>
                                          <Insets top="17.0" />
                                       </VBox.margin>
                                       <font>
                                          <Font size="17.0" />
                                       </font>
                                       <opaqueInsets>
                                          <Insets />
                                       </opaqueInsets>
                                    </TextField>

                                    <!-- New Password Field -->
                                    <PasswordField fx:id="newPasswordField" prefHeight="55.0" prefWidth="376.0" promptText="New Password" styleClass="input-field">
                                       <VBox.margin>
                                          <Insets top="15.0" />
                                       </VBox.margin>
                                       <font>
                                          <Font size="17.0" />
                                       </font>
                                    </PasswordField>

                                    <!-- Confirm New Password Field -->
                                    <PasswordField fx:id="confirmNewPasswordField" prefHeight="55.0" prefWidth="376.0" promptText="Confirm New Password" styleClass="input-field">
                                       <VBox.margin>
                                          <Insets top="15.0" />
                                       </VBox.margin>
                                       <font>
                                          <Font size="17.0" />
                                       </font>
                                    </PasswordField>

                                    <VBox alignment="TOP_CENTER" prefHeight="144.0" prefWidth="376.0">
                                       <children>
                                          <HBox alignment="CENTER" prefHeight="153.0" prefWidth="376.0">
                                             <children>
                                                <!-- Back Button -->
                                                <Button mnemonicParsing="false" onAction="#backToLoginFromChangePassword" prefHeight="54.0" prefWidth="221.0" styleClass="back-button" text="Back">
                                                   <HBox.margin>
                                                      <Insets top="-25.0" />
                                                   </HBox.margin>
                                                </Button>

                                                <!-- Done/Change Password Button -->
                                                <Button mnemonicParsing="false" onAction="#changePassword" prefHeight="55.0" prefWidth="220.0" styleClass="login-button" text="Change Password">
                                                   <HBox.margin>
                                                      <Insets left="12.0" right="4.0" top="-25.0" />
                                                   </HBox.margin>
                                                </Button>
                                             </children>
                                          </HBox>
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</VBox>