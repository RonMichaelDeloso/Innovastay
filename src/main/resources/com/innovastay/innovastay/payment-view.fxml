<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="720.0" prefWidth="1280.0" stylesheets="@app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.innovastay.innovastay.LoginController">

    <children>

        <!-- ✅ Top Logo Bar -->
        <HBox alignment="CENTER_LEFT" prefHeight="64.0" spacing="10" styleClass="upper-form">
            <children>
                <!-- Left: Logo -->
                <ImageView fitHeight="54.0" onMouseClicked="#goHome" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                    <image>
                        <Image url="@image/inova%20logo(1)(1).png" />
                    </image>
                    <HBox.margin>
                        <Insets left="15.0" />
                    </HBox.margin>
                </ImageView>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Right: Menu Icon -->
                <ImageView fitHeight="45.0" fitWidth="45.0" opacity="0.76" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@image/icon-menu.png" />
                    </image>
                    <HBox.margin>
                        <Insets right="15.0" />
                    </HBox.margin>
                </ImageView>
            </children>
        </HBox>

        <!-- ✅ Payment Section -->
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #f8f9fa; -fx-padding: 30;">
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>

            <!-- Payment Card -->
            <VBox maxWidth="800.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 5);">

                <!-- Payment Header -->
                <VBox alignment="CENTER_LEFT" prefHeight="31.0" prefWidth="800.0" spacing="10.0" style="-fx-padding: 25; -fx-background-color: #2c5aa0;">
                    <Label style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" text="Payment Details" />
                </VBox>

                <!-- Payment Body -->
                <VBox spacing="25.0" style="-fx-padding: 30;">

                    <!-- Card Information Section -->
                    <VBox spacing="15.0">
                        <Label style="-fx-text-fill: #2c5aa0; -fx-font-size: 20; -fx-font-weight: bold;" text="Credit Card Details" />

                        <GridPane hgap="15.0" vgap="15.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Name on Card" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <TextField promptText="Enter name as shown on card" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label style="-fx-font-weight: bold;" text="Card Number" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField promptText="1234 5678 9012 3456" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label style="-fx-font-weight: bold;" text="Expiry Date" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <TextField prefWidth="80.0" promptText="MM/YY" />
                                    <Label style="-fx-font-weight: bold;" text="CVC / CVV" />
                                    <TextField prefWidth="60.0" promptText="CVC" />
                                </HBox>
                            </children>
                        </GridPane>
                    </VBox>

                    <Separator />

                    <!-- Other Payment Options -->
                    <VBox maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="100.0" prefWidth="739.0" spacing="15.0">
                        <Label style="-fx-text-fill: #2c5aa0; -fx-font-size: 18; -fx-font-weight: bold;" text="Other Payment Options:" />

                        <VBox spacing="10.0">
                     <children>
                        <Button maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#Gcash" prefHeight="62.0" prefWidth="166.0" text="GCash" />
                     </children></VBox>
                    </VBox>

                    <Separator />

                    <!-- Pay Now Section -->
                    <VBox alignment="CENTER" spacing="10.0">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #2c5aa0;" text="Total Amount: PHP 4,161.00" />
                        <Button onAction="#Payed" style="-fx-background-color: #2c5aa0; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 15 30; -fx-background-radius: 8; -fx-font-size: 16;" text="PROCEED TO PAYMENT" />
                    </VBox>
                </VBox>
            </VBox>
        </VBox>
    </children>
</VBox>
